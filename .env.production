# Production build settings — loaded automatically by `vite build`
# (mode=production), i.e. by `npm run tauri:build` and by the Desktop release
# workflow. Committed on purpose: release builds must never fall back to the
# localhost defaults in src/lib/env.ts. Local dev keeps using the gitignored
# `.env`.
VITE_API_URL=https://api.interviewveil.com
VITE_WEB_URL=https://www.interviewveil.com
